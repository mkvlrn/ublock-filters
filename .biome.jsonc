{
  "$schema": "node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**/*",
      "!**/node_modules/**/*",
      "!**/build/**/*",
      "!**/coverage/**/*",
      "!**/*.d.ts"
    ]
  },
  "extends": ["@mkvlrn/config/biome.json"],
  "overrides": [
    { "includes": ["**/*"], "linter": { "rules": { "correctness": { "noNodejsModules": "off" } } } }
  ]
}
